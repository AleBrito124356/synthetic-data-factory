# =============================================================================
# synthetic-data-factory — environment configuration
# =============================================================================
# The TABULAR generator needs NONE of these. Copy this file to `.env` only if
# you want the LLM-backed `text` and `qa` generators.
#
#   cp .env.example .env
#
# -----------------------------------------------------------------------------

# NVIDIA NIM API key. Free — sign up at https://build.nvidia.com and create a
# key from any model page (takes ~2 minutes). Keys start with "nvapi-".
# Leave unset to run the zero-dollar tabular path only.
NVIDIA_API_KEY=nvapi-XXXXXXXXXXXXXXXXXXXXXXXX

# OpenAI-compatible base URL for NVIDIA NIM. Override only if you proxy it
# (e.g. through llm-gateway) or point at a local vLLM/Ollama shim.
NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Chat model used by the text and qa generators. Any NIM chat model works.
NIM_MODEL=meta/llama-3.3-70b-instruct

# Embedding model used for semantic dedup of generated text. Any NIM embedding
# model works; leave as-is unless you have a preference.
NIM_EMBED_MODEL=nvidia/nv-embedqa-e5-v5
